{
  "extends": "./tsconfig.base.json",
  "include": ["packages", "clients", "tests", "e2e", "*.config.ts"],
  "exclude": [
    "node_modules",
    "**/dist/**",
    "packages/api-client/src/generated",
    "packages/postgres-store/migrations"
