:80 {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:4100
	}

	handle /auth/* {
		reverse_proxy api:4100
	}

	handle /health {
		reverse_proxy api:4100
	}

	# The runtime a generated view loads, served by the API.
	handle /app-runtime/* {
		reverse_proxy api:4100
	}

	handle {
		reverse_proxy ui:80
	}
}
