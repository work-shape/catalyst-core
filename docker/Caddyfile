# This Caddy is the outermost proxy: it passes the client's own address to the API, which
# counts sign-in attempts by it. Behind another proxy or load balancer, add
#
#   {
#       servers {
#           trusted_proxies static private_ranges
#       }
#   }
#
# at the top of this file. Without it every client reaches the API as that proxy's address.
:80 {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:4100
	}

	handle /auth/* {
		reverse_proxy api:4100
	}

	handle /health {
		reverse_proxy api:4100
	}

	# The runtime a generated view loads, served by the API.
	handle /app-runtime/* {
		reverse_proxy api:4100
	}

	# The files of a Page, served by the API. The address holds a token that serves the Page to
	# whoever has it for an hour: this site writes no access log, and one that is added must
	# leave these addresses out (`log_skip` on this matcher).
	handle /app-content/* {
		reverse_proxy api:4100
	}

	handle {
		reverse_proxy ui:80
	}
}
