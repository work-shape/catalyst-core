{
  "name": "@work-shape/catalyst-app-build",
  "version": "0.8.0-rc.3",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/work-shape/catalyst-core",
    "directory": "packages/app-build"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "catalyst-page-build": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./build": {
      "types": "./dist/build.d.ts",
      "development": "./src/build.ts",
      "import": "./dist/build.js"
    }
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://registry.npmjs.org/",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./build": {
        "types": "./dist/build.d.ts",
        "import": "./dist/build.js"
      }
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/build.ts src/cli.ts --format esm --dts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tanstack/router-generator": "1.167.41",
    "@work-shape/catalyst-core": "workspace:*",
    "esbuild": "0.28.0",
    "parse5": "7.3.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
