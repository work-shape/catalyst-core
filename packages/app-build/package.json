{
  "name": "@vivd-catalyst/app-build",
  "version": "0.6.3",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vivd-solutions/vivd-catalyst.git",
    "directory": "packages/app-build"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://registry.npmjs.org/",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/build-process.ts --format esm --dts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tanstack/router-generator": "1.167.41",
    "@vivd-catalyst/core": "workspace:*",
    "esbuild": "0.28.0",
    "parse5": "7.3.0",
    "js-yaml": "^4.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.13.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
