{
  "name": "@vivd-catalyst/ui",
  "version": "0.6.3",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vivd-solutions/vivd-catalyst.git",
    "directory": "packages/ui"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "src"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "development": "./src/theme/index.ts",
      "import": "./dist/theme/index.js"
    },
    "./gallery": {
      "types": "./dist/gallery/index.d.ts",
      "development": "./src/gallery/index.tsx",
      "import": "./dist/gallery/index.js"
    },
    "./chart-engine": {
      "types": "./dist/data/chart-engine.d.ts",
      "development": "./src/data/chart-engine.ts",
      "import": "./dist/data/chart-engine.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://registry.npmjs.org/",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./theme": {
        "types": "./dist/theme/index.d.ts",
        "import": "./dist/theme/index.js"
      },
      "./gallery": {
        "types": "./dist/gallery/index.d.ts",
        "import": "./dist/gallery/index.js"
      },
      "./chart-engine": {
        "types": "./dist/data/chart-engine.d.ts",
        "import": "./dist/data/chart-engine.js"
      },
      "./styles.css": "./src/styles.css"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/theme/index.ts src/gallery/index.tsx src/data/chart-engine.ts --format esm --dts --external react --external react-dom",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "echarts": "6.1.0",
    "lucide-react": "^1.17.0",
    "radix-ui": "^1.6.2",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
