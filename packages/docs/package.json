{
  "name": "@vivd-catalyst/docs",
  "version": "0.6.3",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && node scripts/generate-api-reference.mjs && astro build && cp -R host/. dist/",
    "dev": "node scripts/generate-api-reference.mjs && astro dev --host 127.0.0.1 --port 4321",
    "check:site": "node scripts/check-site.mjs",
    "generate:api-reference": "node scripts/generate-api-reference.mjs",
    "preview": "astro preview --host 127.0.0.1 --port 4321",
    "typecheck": "node scripts/generate-api-reference.mjs && astro check"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.40.0",
    "astro": "^6.4.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@vivd-catalyst/api-contract": "workspace:*",
    "typescript": "^6.0.3",
    "vite": "^7.3.5"
  }
}
