{
  "name": "@work-shape/catalyst-workflows",
  "version": "0.8.0-rc.3",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/work-shape/catalyst-core",
    "directory": "packages/workflows"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://registry.npmjs.org/",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "probes": "node scripts/probes.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@work-shape/catalyst-connections": "workspace:*",
    "@work-shape/catalyst-core": "workspace:*",
    "@work-shape/catalyst-tool-execution": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
