{
  "name": "@work-shape/catalyst-client-assembly",
  "version": "0.8.0-rc.18",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/work-shape/catalyst-core",
    "directory": "packages/client-assembly"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "catalyst-local-key": "./dist/local-key-cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://registry.npmjs.org/",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/local-key-cli.ts --format esm --dts",
    "generate:platform-docs": "pnpm --filter @work-shape/catalyst-app-build build && node scripts/platform-docs.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@work-shape/catalyst-agent-runtime": "workspace:*",
    "@work-shape/catalyst-api-client": "workspace:*",
    "@work-shape/catalyst-api-contract": "workspace:*",
    "@work-shape/catalyst-app-build": "workspace:*",
    "@work-shape/catalyst-asset-repo": "workspace:*",
    "@work-shape/catalyst-auth": "workspace:*",
    "@work-shape/catalyst-capability-sdk": "workspace:*",
    "@work-shape/catalyst-server": "workspace:*",
    "@work-shape/catalyst-config-schema": "workspace:*",
    "@work-shape/catalyst-connections": "workspace:*",
    "@work-shape/catalyst-core": "workspace:*",
    "@work-shape/catalyst-postgres-connector": "workspace:*",
    "@work-shape/catalyst-data-stores": "workspace:*",
    "@work-shape/catalyst-mail": "workspace:*",
    "@work-shape/catalyst-model-provider": "workspace:*",
    "@work-shape/catalyst-object-storage": "workspace:*",
    "@work-shape/catalyst-postgres-store": "workspace:*",
    "@work-shape/catalyst-tool-execution": "workspace:*",
    "@work-shape/catalyst-tool-sdk": "workspace:*",
    "@work-shape/catalyst-usage-governance": "workspace:*",
    "@work-shape/catalyst-web-access": "workspace:*",
    "@work-shape/catalyst-workflows": "workspace:*",
    "dotenv": "^17.4.2",
    "pino": "10.3.1",
    "yaml": "~2.9.1",
    "zod": "4.4.3",
    "@work-shape/catalyst-preview-capture": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.13.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
