{
  "name": "@work-shape/catalyst-server",
  "version": "0.8.0-rc.13",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/work-shape/catalyst-core",
    "directory": "packages/server"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "vendor"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://registry.npmjs.org/",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "11.2.0",
    "@fastify/multipart": "9.4.0",
    "@work-shape/catalyst-api-contract": "workspace:*",
    "@work-shape/catalyst-app-build": "workspace:*",
    "@work-shape/catalyst-asset-repo": "workspace:*",
    "@work-shape/catalyst-auth": "workspace:*",
    "@work-shape/catalyst-config-schema": "workspace:*",
    "@work-shape/catalyst-core": "workspace:*",
    "@work-shape/catalyst-mail": "workspace:*",
    "@work-shape/catalyst-model-provider": "workspace:*",
    "@work-shape/catalyst-tool-execution": "workspace:*",
    "@work-shape/catalyst-usage-governance": "workspace:*",
    "ai": "6.0.224",
    "fastify": "5.12.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
