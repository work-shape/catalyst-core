{
  "name": "@work-shape/catalyst-demo",
  "version": "0.8.0-rc.7",
  "private": true,
  "type": "module",
  "exports": {
    "./sample-mcp": "./sample-mcp/index.ts",
    "./seed": "./src/seed/index.ts"
  },
  "scripts": {
    "build": "tsup src/server.ts src/e2e-server.ts src/seed-auth.ts src/migrate.ts src/knowledge-worker.ts src/artifact-preview-worker.ts src/workspace-command-worker.ts src/sample-mcp-server.ts --format esm --out-dir dist && vite build",
    "build:server": "tsup src/server.ts src/e2e-server.ts src/seed-auth.ts src/migrate.ts src/knowledge-worker.ts src/artifact-preview-worker.ts src/workspace-command-worker.ts src/sample-mcp-server.ts --format esm --out-dir dist",
    "build:ui": "vite build",
    "config:local-key": "pnpm --filter \"@work-shape/catalyst-client-assembly...\" build && node --env-file-if-exists=.env ../../packages/client-assembly/dist/local-key-cli.js --instance http://127.0.0.1:4100",
    "config:diff": "pnpm --filter \"@work-shape/catalyst-cli...\" build && node --env-file-if-exists=.env ../../packages/config-cli/dist/index.js config diff --dir .",
    "demo:seed": "pnpm --filter \"@work-shape/catalyst-client-assembly...\" --filter \"@work-shape/catalyst-cli...\" build && tsup src/demo-seed.ts --format esm --out-dir dist && node --env-file-if-exists=.env dist/demo-seed.js",
    "config:push": "pnpm --filter \"@work-shape/catalyst-cli...\" build && node --env-file-if-exists=.env ../../packages/config-cli/dist/index.js config push --dir .",
    "dev": "node scripts/ensure-local-secrets.mjs && docker compose build migrate && docker compose watch api ui knowledge-worker artifact-preview-worker workspace-command-worker sample-mcp",
    "dev:down": "docker compose down",
    "dev:db": "docker compose up -d postgres",
    "dev:restart": "pnpm run dev",
    "dev:prod": "docker compose --env-file .env.prod -f docker-compose.prod.yml up --build",
    "prod:config": "docker compose --env-file .env.prod -f docker-compose.prod.yml config",
    "dev:ui": "vite --host 0.0.0.0 --port 5173",
    "preview:ui": "vite preview --host 127.0.0.1 --port 5173 --outDir dist/client",
    "seed:auth": "docker compose run --rm api node clients/demo/dist/seed-auth.js",
    "start": "node dist/server.js",
    "start:sample-mcp": "node --env-file-if-exists=.env dist/sample-mcp-server.js",
    "start:artifact-preview-worker": "node dist/artifact-preview-worker.js",
    "start:workspace-command-worker": "node dist/workspace-command-worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:knowledge-worker-compose": "node ../../packages/deployment-kit/verify/knowledge-worker-compose.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@work-shape/catalyst-api-client": "workspace:*",
    "@work-shape/catalyst-chat-ui": "workspace:*",
    "@work-shape/catalyst-client-assembly": "workspace:*",
    "@work-shape/catalyst-config-schema": "workspace:*",
    "@work-shape/catalyst-core": "workspace:*",
    "@work-shape/catalyst-tool-sdk": "workspace:*",
    "@work-shape/catalyst-ui": "workspace:*",
    "@work-shape/catalyst-cli": "workspace:*",
    "lucide-react": "^1.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.13.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "tailwindcss": "^4.3.0",
    "tsup": "^8.5.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "8.0.16"
  }
}
