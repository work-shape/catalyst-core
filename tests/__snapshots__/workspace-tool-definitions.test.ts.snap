  {
    "name": "workspace.preview_images",
    "description": "Load bounded rendered preview images into model-visible visual context. This is how to check rendered output: images loaded here are never listed among the person's files, so render checks under /workspace/previews and promote with workspace.promote_artifact only the files the person should get. Give exactly one source: artifactId, path, or paths. Use path/paths for rendered image files under /workspace/previews, or artifactId with page/slide/sheet/range selectors for managed DOCX/XLSX/PPTX/PDF artifacts. The result reports pending, failed, or unsupported when pixels are not actually attached. Loaded images stay in visual context for the current turn only; call the tool again in a later turn to see them again.",
    "permission": null,
    "inputJsonSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifactId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "description": "Managed source artifact id for DOCX/XLSX/PPTX/PDF preview rendering or already-managed image previews."
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "Workspace path to a rendered preview image, usually under previews/, e.g. previews/report/page-1.png or /workspace/previews/report/page-1.png."
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "description": "Workspace paths to rendered preview images, usually under previews/. Preview images are model-visible but are not user-download artifacts unless separately promoted."
        },
        "pages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "description": "Optional PDF/DOCX page numbers to load when preview metadata has page numbers."
        },
        "slides": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "description": "Optional PPTX slide numbers to load when preview metadata has slide numbers."
        },
        "sheets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "description": "Optional XLSX sheet names to load when preview metadata has sheet labels."
        },
        "ranges": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "description": "Optional XLSX ranges to load. Prefer sheet-qualified ranges like \`Summary!A1:B4\`; unqualified ranges require exactly one \`sheets\` value."
        },
        "maxImages": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12,
          "default": 12,
          "description": "Maximum preview images to attach to model context."
        }
      }
    },
