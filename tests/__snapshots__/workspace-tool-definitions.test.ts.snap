  {
    "name": "workspace.read_file",
    "description": "Read UTF-8 text from a file in this conversation's execution workspace, by lines. Without offset and limit the answer starts at line 1 and holds up to 400 lines or 16 KiB, whichever comes first. It ends at a whole line and lines carry no number prefix. The answer says which lines it holds (startLine, endLine) and how many the file has (totalLines). When lines remain, truncated is true and nextOffset is the line to continue with: call again with offset set to nextOffset until nextOffset is absent. One exception: a single line that is longer than one answer is cut inside the line. The answer then has lineCut true and a hint, nextOffset skips the rest of that line, and the rest is read with a command in workspace.exec. Binary files and files above 8 MiB are refused; read those with a command in workspace.exec.",
    "permission": null,
    "inputJsonSchema": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 512
        },
        "offset": {
          "type": "integer",
          "minimum": 1,
          "description": "First line to return, counted from 1. Omit it to start at line 1. To continue, pass the nextOffset of the previous answer."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of lines to return. Omit it for up to 400 lines."
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    },
    "inputSchema": {
