  {
    "name": "workspace.preview_images",
    "description": "Load bounded rendered preview images into model-visible visual context without promoting preview files to the user. Use path/paths for rendered image files under /workspace/previews, or artifactId with page/slide/sheet/range selectors for managed DOCX/XLSX/PPTX/PDF artifacts. The result reports pending, failed, or unsupported when pixels are not actually attached. Loaded images stay in visual context for the current turn only; call the tool again in a later turn to see them again.",
    "permission": null,
    "inputJsonSchema": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "artifactId"
          ]
        },
        {
          "required": [
            "path"
          ]
        },
        {
          "required": [
            "paths"
          ]
        }
      ],
      "properties": {
        "artifactId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "description": "Managed source artifact id for DOCX/XLSX/PPTX/PDF preview rendering or already-managed image previews."
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "Workspace path to a rendered preview image, usually under previews/, e.g. previews/report/page-1.png or /workspace/previews/report/page-1.png."
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "description": "Workspace paths to rendered preview images, usually under previews/. Preview images are model-visible but are not user-download artifacts unless separately promoted."
        },
        "pages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "description": "Optional PDF/DOCX page numbers to load when preview metadata has page numbers."
        },
        "slides": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "description": "Optional PPTX slide numbers to load when preview metadata has slide numbers."
        },
        "sheets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "description": "Optional XLSX sheet names to load when preview metadata has sheet labels."
        },
        "ranges": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "description": "Optional XLSX ranges to load. Prefer sheet-qualified ranges like \`Summary!A1:B4\`; unqualified ranges require exactly one \`sheets\` value."
        },
        "maxImages": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12,
          "default": 12,
          "description": "Maximum preview images to attach to model context."
        }
      }
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "artifactId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "description": "Managed source artifact id for DOCX/XLSX/PPTX/PDF preview rendering or already-managed image previews."
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "Workspace path to a rendered preview image, usually under previews/, e.g. previews/report/page-1.png or /workspace/previews/report/page-1.png."
        },
        "paths": {
          "minItems": 1,
          "maxItems": 12,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "description": "Workspace paths to rendered preview images, usually under previews/. Preview images are model-visible but are not user-download artifacts unless separately promoted."
        },
        "pages": {
          "minItems": 1,
          "maxItems": 12,
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "description": "Optional PDF/DOCX page numbers to load when preview metadata has page numbers."
        },
        "slides": {
          "minItems": 1,
          "maxItems": 12,
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "description": "Optional PPTX slide numbers to load when preview metadata has slide numbers."
        },
        "sheets": {
          "minItems": 1,
          "maxItems": 12,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "description": "Optional XLSX sheet names to load when preview metadata has sheet labels."
        },
        "ranges": {
          "minItems": 1,
          "maxItems": 12,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "description": "Optional XLSX ranges to load. Prefer sheet-qualified ranges like \`Summary!A1:B4\`; unqualified ranges require exactly one \`sheets\` value."
        },
        "maxImages": {
          "default": 12,
          "description": "Maximum preview images to attach to model context.",
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        }
      },
      "additionalProperties": false
    },
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "artifactId": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "ready",
            "pending",
            "failed",
            "unsupported"
          ]
        },
        "maxImages": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "images": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sourceArtifactId": {
                "type": "string"
              },
              "imageArtifactId": {
                "type": "string"
              },
              "mimeType": {
                "type": "string",
                "enum": [
                  "image/png",
                  "image/jpeg",
                  "image/webp",
                  "image/gif"
                ]
              },
              "status": {
                "type": "string",
                "const": "ready"
              },
              "pageNumber": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "slideNumber": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "sheet": {
                "type": "string"
              },
              "range": {
                "type": "string"
              },
              "width": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "height": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "sourceArtifactId",
              "imageArtifactId",
              "mimeType",
              "status"
            ],
            "additionalProperties": false
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "pageNumber": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "slideNumber": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "sheet": {
                "type": "string"
              },
              "range": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "errorCode": {
          "type": "string"
        }
      },
      "required": [
        "artifactId",
        "status",
        "maxImages",
        "images",
        "warnings"
      ],
      "additionalProperties": false
    }
  }
]"
`;
