          "minimum": 1,
          "maximum": 9007199254740991
        },
        "lineCut": {
          "type": "boolean"
        },
        "hint": {
          "type": "string"
        }
      },
      "required": [
        "workspaceId",
        "path",
        "byteSize",
        "encoding",
