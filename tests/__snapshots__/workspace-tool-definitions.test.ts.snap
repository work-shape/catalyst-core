  {
    "name": "workspace.preview_images",
    "description": "Load rendered preview images so you can see them, to check rendered output. They are never listed among the person's files: render checks under /workspace/previews and promote with workspace.promote_artifact only what the person should get. Give exactly one source: artifactId, path, or paths. Use path or paths for images under /workspace/previews, or artifactId with page, slide, sheet or range selectors for a managed DOCX, XLSX, PPTX or PDF. The result says pending, failed or unsupported when no pixels are attached. Images stay visible for this turn only.",
    "permission": null,
    "inputJsonSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifactId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "description": "Managed DOCX/XLSX/PPTX/PDF or image artifact id."
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "A rendered preview image, such as previews/report/page-1.png."
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "description": "Rendered preview images, usually under previews/."
        },
        "pages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "description": "PDF/DOCX page numbers."
        },
        "slides": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "description": "PPTX slide numbers."
        },
        "sheets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "description": "XLSX sheet names."
        },
        "ranges": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "description": "XLSX ranges such as \`Summary!A1:B4\`; an unqualified range needs exactly one \`sheets\` value."
        },
        "maxImages": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12,
          "default": 12,
          "description": "Most images to load."
        }
      }
    },
