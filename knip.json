{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "packages/*": {
      "entry": [
        "src/index.{ts,tsx}",
        "src/{shell,admin}.tsx",
        "src/vite.js",
        "scripts/**/*.{ts,mjs,js}",
        "*.config.{ts,js,mjs}"
      ],
      "project": [
        "src/**/*.{ts,tsx,mts,cts,js}",
        "scripts/**/*.{ts,mts,cts,mjs,js}",
        "*.{ts,mts,cts,js,mjs}"
      ],
      "vite": false
    },
    "packages/chat-ui": {
      "entry": [
        "src/index.tsx",
        "src/{shell,admin}.tsx",
        "src/vite.js",
        "src/pages/index.ts",
        "*.config.{ts,js,mjs}"
      ],
      "project": ["src/**/*.{ts,tsx,mts,cts,js}", "*.{ts,mts,cts,js,mjs}"],
      "vite": false
    },
    "packages/app-build": {
      "entry": ["src/index.ts", "src/build.ts", "src/cli.ts"],
      "project": ["src/**/*.ts"],
      "vite": false
    },
    "packages/app-kit": {
      "entry": ["src/index.ts", "src/router-entry.ts", "scripts/release.mjs"],
      "project": ["src/**/*.{ts,tsx}", "scripts/**/*.mjs"],
      "vite": false
    },
    "packages/ui": {
      "entry": ["src/index.ts", "src/theme/index.ts", "src/gallery/index.tsx"],
      "project": ["src/**/*.{ts,tsx}"],
      "vite": false
    },
    "packages/quality-config": {
      "entry": ["check.mjs", "baseline-guard.mjs", "eslint.config.mjs", "baseline.mjs"],
      "project": ["*.mjs"],
      "vite": false
    },
    "packages/deployment-kit": {
      "entry": ["{dev,verify}/*.mjs"],
      "project": ["{dev,verify}/**/*.mjs"],
      "vite": false
    },
    "clients/*": {
      "entry": [
        "src/chat-main.tsx",
        "src/server.ts",
        "src/e2e-server.ts",
        "src/seed-auth.ts",
        "src/migrate.ts",
        "src/*worker*.ts",
        "*.config.{ts,js,mjs}"
      ],
      "project": [
        "src/**/*.{ts,tsx,mts,cts}",
        "widgets/**/*.{ts,tsx,mts,cts}",
        "tools/**/*.{ts,mts,cts}",
        "*.config.{ts,js,mjs}"
      ],
      "vite": false
    },
    "packages/chat-standalone": {
      "entry": ["src/main.tsx", "vite.config.ts"],
      "project": ["src/**/*.{ts,tsx,mts,cts}", "vite.config.ts"],
      "vite": false
    },
    ".": {
      "entry": [
        "tests/**/*.test.ts",
        "e2e/**/*.ts",
        "scripts/**/*.mjs",
        "*.config.ts",
        "eslint.config.mjs"
      ],
      "project": [
        "tests/**/*.{ts,mts,cts}",
        "e2e/**/*.{ts,mts,cts}",
        "scripts/**/*.mjs",
        "*.config.ts",
        "eslint.config.mjs"
      ],
      "ignoreBinaries": ["mkfifo", "openssl"],
      "vite": false
    }
  },
  "vite": false
}
