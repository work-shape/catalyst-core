{
  "name": "vivd-catalyst",
  "version": "0.8.0-rc.4",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build && pnpm -r --filter './clients/*' build",
    "build:demo": "pnpm -r --filter './packages/*' build && pnpm --filter @work-shape/catalyst-demo build",
    "check": "pnpm build && pnpm format:check && pnpm lint && pnpm typecheck && pnpm check:openapi && pnpm check:contract && pnpm check:migrations && pnpm check:changes && pnpm test && pnpm test:upgrade",
    "check:local": "node scripts/check-local.mjs",
    "check:images": "bash scripts/check-image-build.sh",
    "check:contract": "pnpm --filter @work-shape/catalyst-api-contract check:contract",
    "check:openapi": "pnpm --filter @work-shape/catalyst-api-contract check:openapi",
    "generate:openapi": "pnpm --filter @work-shape/catalyst-api-contract generate:openapi",
    "generate:platform-docs": "pnpm --filter @work-shape/catalyst-client-assembly generate:platform-docs",
    "check:migrations": "node scripts/migrations/check.mjs",
    "check:changes": "node scripts/release/changelog.mjs --check",
    "changelog": "node scripts/release/changelog.mjs",
    "db:preflight:collaboration-workspaces": "node scripts/preflight-collaboration-workspaces.mjs",
    "db:generate": "drizzle-kit generate",
    "dev": "pnpm dev:demo",
    "dev:demo": "pnpm --filter @work-shape/catalyst-demo dev",
    "docs:build": "pnpm --filter @work-shape/catalyst-docs build",
    "docs:dev": "pnpm --filter @work-shape/catalyst-docs dev",
    "docs:preview": "pnpm --filter @work-shape/catalyst-docs preview",
    "format": "catalyst-quality format --write",
    "format:check": "catalyst-quality format",
    "release:check": "node scripts/release/check-lock-integrity.mjs && node scripts/release/check-packages.mjs",
    "release:cut": "node scripts/release/cut.mjs",
    "release:check:public": "node scripts/release/check-public-tarball.mjs",
    "release:metadata": "node scripts/release/package-metadata.mjs --write",
    "test": "vitest run && pnpm test:deployment-kit",
    "test:compatibility": "pnpm --filter '@work-shape/catalyst-postgres-store...' build && node scripts/migrations/compatibility.mjs",
    "test:upgrade": "vitest run --config vitest.upgrade.config.ts",
    "test:deployment-kit": "bash packages/deployment-kit/tests/test-deployment-kit.sh && node --test packages/deployment-kit/tests/*.test.mjs",
    "test:e2e": "node scripts/run-chat-e2e.mjs --all",
    "test:e2e:chat": "node scripts/run-chat-e2e.mjs --all",
    "test:e2e:chat-state": "node scripts/run-chat-e2e.mjs --state",
    "test:e2e:chat-state:headed": "node scripts/run-chat-e2e.mjs --state -- --headed",
    "test:e2e:live-agent-artifacts": "node scripts/run-live-agent-artifact-e2e.mjs",
    "typecheck": "pnpm typecheck:packages && pnpm typecheck:tests && pnpm typecheck:docs",
    "lint": "catalyst-quality lint",
    "typecheck:packages": "catalyst-quality types:packages",
    "typecheck:tests": "catalyst-quality types:tests",
    "typecheck:docs": "pnpm --filter @work-shape/catalyst-docs typecheck",
    "kit:release": "pnpm --filter @work-shape/catalyst-app-kit release",
    "check:affected": "node scripts/check-affected.mjs",
    "release:guard": "node scripts/release/guard.mjs",
    "release:publish": "node scripts/release/publish.mjs",
    "test:release": "node --test scripts/release/release.test.mjs",
    "test:release:mirror": "node --test scripts/release/mirror-proof.mjs",
    "test:agent-stories": "node scripts/run-agent-stories.mjs"
  },
  "devDependencies": {
    "@assistant-ui/react": "^0.14.26",
    "@assistant-ui/react-ai-sdk": "1.3.40",
    "@playwright/test": "^1.60.0",
    "@tanstack/react-query": "^5.101.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@univerjs/core": "0.25.1",
    "@vitejs/plugin-react": "^6.0.2",
    "@work-shape/catalyst-app-build": "workspace:*",
    "@work-shape/catalyst-app-kit": "workspace:*",
    "@work-shape/catalyst-asset-repo": "workspace:*",
    "@work-shape/catalyst-core": "workspace:*",
    "@work-shape/catalyst-postgres-store": "workspace:*",
    "@work-shape/catalyst-quality-config": "workspace:*",
    "drizzle-kit": "^0.31.10",
    "esbuild": "0.28.0",
    "exceljs": "4.4.0",
    "happy-dom": "21.0.3",
    "jszip": "3.10.1",
    "postgres": "^3.4.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.12",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3",
    "yaml": "2.9.1"
  }
}
