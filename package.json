{
  "name": "vivd-catalyst",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build && pnpm -r --filter './clients/*' build",
    "build:demo": "pnpm -r --filter './packages/*' build && pnpm --filter @vivd-catalyst/demo build",
    "check": "pnpm build && pnpm format:check && pnpm lint && pnpm typecheck && pnpm check:migrations && pnpm test && pnpm test:upgrade && pnpm check:browser:cb-1b",
    "check:local": "node scripts/check-local.mjs",
    "check:migrations": "node scripts/migrations/check.mjs",
    "db:preflight:collaboration-workspaces": "node scripts/preflight-collaboration-workspaces.mjs",
    "db:generate": "drizzle-kit generate",
    "dev": "pnpm dev:demo",
    "dev:demo": "pnpm --filter @vivd-catalyst/demo dev",
    "docs:build": "pnpm --filter @vivd-catalyst/docs build",
    "docs:dev": "pnpm --filter @vivd-catalyst/docs dev",
    "docs:preview": "pnpm --filter @vivd-catalyst/docs preview",
    "format": "catalyst-quality format --write",
    "format:check": "catalyst-quality format",
    "release:check": "node scripts/release/check-packages.mjs",
    "release:metadata": "node scripts/release/package-metadata.mjs --write",
    "test": "vitest run && pnpm test:deployment-kit",
    "test:compatibility": "pnpm --filter '@vivd-catalyst/postgres-store...' build && node scripts/migrations/compatibility.mjs",
    "test:upgrade": "vitest run --config vitest.upgrade.config.ts",
    "test:deployment-kit": "bash packages/deployment-kit/tests/test-deployment-kit.sh",
    "test:e2e": "node scripts/run-chat-e2e.mjs --all",
    "test:e2e:chat": "node scripts/run-chat-e2e.mjs --all",
    "test:e2e:chat-state": "node scripts/run-chat-e2e.mjs --state",
    "test:e2e:chat-state:headed": "node scripts/run-chat-e2e.mjs --state -- --headed",
    "test:e2e:live-agent-artifacts": "node scripts/run-live-agent-artifact-e2e.mjs",
    "typecheck": "pnpm typecheck:packages && pnpm typecheck:tests && pnpm typecheck:docs",
    "check:browser:cb-1b": "node -e \"console.log('CB-1b adds the browser check here')\"",
    "lint": "catalyst-quality lint",
    "typecheck:packages": "catalyst-quality types:packages",
    "typecheck:tests": "catalyst-quality types:tests",
    "typecheck:docs": "pnpm --filter @vivd-catalyst/docs typecheck"
  },
  "devDependencies": {
    "@assistant-ui/react": "^0.14.26",
    "@playwright/test": "^1.60.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@univerjs/core": "0.25.1",
    "@vitejs/plugin-react": "^6.0.2",
    "@vivd-catalyst/quality-config": "workspace:*",
    "drizzle-kit": "^0.31.10",
    "exceljs": "4.4.0",
    "jszip": "3.10.1",
    "postgres": "^3.4.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "xlsx": "0.18.5",
    "zod": "^4.4.3"
  }
}
